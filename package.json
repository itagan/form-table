{
  "name": "formtable-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter formtable-playground dev",
    "site:dev": "run-p dev docs:dev",
    "build": "run-s build:package build:playground",
    "build:package": "pnpm --filter @itagan/form-table build",
    "build:playground": "pnpm --filter formtable-playground build",
    "docs:install": "pnpm --dir docs --ignore-workspace install --frozen-lockfile",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:dev": "pnpm --dir docs --ignore-workspace dev",
    "docs:build": "run-s docs:install docs:build-only",
    "docs:build-only": "pnpm --dir docs --ignore-workspace build",
    "docs:preview": "pnpm --dir docs --ignore-workspace preview",
    "pack:dry-run": "cd packages/form-table && npm pack --dry-run",
    "preview": "pnpm --filter formtable-playground preview",
    "release:check": "run-s lint test:coverage type-check build docs:check docs:build pack:dry-run",
    "lint": "eslint --ext .ts,.vue packages/form-table/src playground/src",
    "test": "pnpm --filter @itagan/form-table test",
    "test:coverage": "pnpm --filter @itagan/form-table test:coverage",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "@types/node": "^16.11.45",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-legacy": "^2.0.0",
    "@vitejs/plugin-vue2": "^1.1.2",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "21.1.2",
    "less": "^4.4.0",
    "npm-run-all": "^4.1.5",
    "terser": "^5.14.2",
    "typescript": "~4.7.4",
    "vite": "^3.0.2",
    "vue": "2.7.16",
    "vue-tsc": "^0.38.8"
  }
}
