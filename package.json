{
  "name": "formtable-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter formtable-playground dev",
    "build": "run-s build:package build:playground",
    "build:package": "pnpm --filter formtable build",
    "build:playground": "pnpm --filter formtable-playground build",
    "preview": "pnpm --filter formtable-playground preview",
    "test": "pnpm --filter formtable test",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "@types/node": "^16.11.45",
    "@vitejs/plugin-legacy": "^2.0.0",
    "@vitejs/plugin-vue2": "^1.1.2",
    "@vue/tsconfig": "^0.1.3",
    "less": "^4.4.0",
    "npm-run-all": "^4.1.5",
    "terser": "^5.14.2",
    "typescript": "~4.7.4",
    "vite": "^3.0.2",
    "vue-tsc": "^0.38.8",
    "vitest": "0.34.6"
  }
}
