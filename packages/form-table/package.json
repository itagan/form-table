{
  "name": "@itagan/form-table",
  "version": "0.2.0",
  "description": "Vue 2.7 + Element UI editable form table component.",
  "type": "module",
  "main": "./dist/formtable.umd.cjs",
  "module": "./dist/formtable.es.js",
  "types": "./dist/types/public-types.d.ts",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/public-types.d.ts",
      "import": "./dist/formtable.es.js",
      "require": "./dist/formtable.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "itagan",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/itagan/form-table.git",
    "directory": "packages/form-table"
  },
  "homepage": "https://gitee.com/itagan/form-table#readme",
  "bugs": {
    "url": "https://gitee.com/itagan/form-table/issues"
  },
  "scripts": {
    "build": "run-s build:lib build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "element-ui": "^2.4.9",
    "vue": "^2.7.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "0.34.6",
    "@vue/test-utils": "1.3.6",
    "element-ui": "^2.15.14",
    "element-ui-legacy": "npm:element-ui@2.4.9",
    "jsdom": "21.1.2",
    "vitest": "0.34.6",
    "vue": "^2.7.7",
    "vue-template-compiler": "2.7.16"
  },
  "keywords": [
    "vue2",
    "vue",
    "element-ui",
    "editable-table",
    "form",
    "table",
    "typescript"
  ],
  "license": "MIT"
}
