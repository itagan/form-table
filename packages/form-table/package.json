{
  "name": "formtable",
  "version": "0.1.0",
  "description": "Vue 2.7 + Element UI editable form table component.",
  "type": "module",
  "main": "./dist/formtable.umd.cjs",
  "module": "./dist/formtable.es.js",
  "types": "./dist/types/public-types.d.ts",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/public-types.d.ts",
      "import": "./dist/formtable.es.js",
      "require": "./dist/formtable.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/itagan/form-table.git",
    "directory": "packages/form-table"
  },
  "homepage": "https://gitee.com/itagan/form-table#readme",
  "bugs": {
    "url": "https://gitee.com/itagan/form-table/issues"
  },
  "scripts": {
    "build": "run-s build:lib build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "element-ui": "^2.15.14",
    "vue": "^2.7.7"
  },
  "devDependencies": {
    "element-ui": "^2.15.14",
    "vue": "^2.7.7"
  },
  "keywords": [
    "vue2",
    "vue",
    "element-ui",
    "editable-table",
    "form",
    "table",
    "typescript"
  ],
  "license": "MIT"
}
